# Copie para .env e preencha com valores reais (o .env nunca é commitado).

# Banco
DB_USERNAME=reservvo
DB_PASSWORD=troque-esta-senha

# Redis
REDIS_PASSWORD=troque-esta-senha

# JWT — gere com: openssl rand -base64 48
JWT_SECRET=

# CORS — origens do front separadas por vírgula. Em branco = localhost (dev).
CORS_ALLOWED_ORIGINS=https://reservvo.cloud

# AWS SES (envio de email) — deixe em branco se ainda não configurou.
# Sem credenciais, o envio de email é ignorado (o app funciona normal).
AWS_REGION=sa-east-1
AWS_FROM_EMAIL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
