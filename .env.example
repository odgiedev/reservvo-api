# Copie para .env e preencha com valores reais (o .env nunca é commitado).

# Banco
DB_USERNAME=reservvo
DB_PASSWORD=troque-esta-senha

# Redis
REDIS_PASSWORD=troque-esta-senha

# JWT — gere com: openssl rand -base64 48
JWT_SECRET=

# AWS SES (envio de email)
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
